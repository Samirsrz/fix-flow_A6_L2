<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your New Verification Code</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 40px 15px;">
    <tr>
        <td align="center">

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                max-width: 520px;
                background-color: #ffffff;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            ">

                <!-- Header -->
                <tr>
                    <td style="
                        background: linear-gradient(135deg, #7c3aed, #4f46e5);
                        padding: 35px 30px;
                        text-align: center;
                    ">

                        <div style="
                            width: 65px;
                            height: 65px;
                            margin: 0 auto 15px;
                            background-color: rgba(255,255,255,0.18);
                            border-radius: 50%;
                            line-height: 65px;
                            font-size: 30px;
                        ">
                            🔄
                        </div>

                        <h1 style="
                            margin: 0;
                            color: #ffffff;
                            font-size: 28px;
                        ">
                            New Verification Code
                        </h1>

                        <p style="
                            margin: 10px 0 0;
                            color: #ede9fe;
                            font-size: 14px;
                        ">
                            Here's your new code
                        </p>

                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding: 40px 35px;">

                        <h2 style="
                            margin: 0 0 15px;
                            font-size: 22px;
                            color: #111827;
                        ">
                            Hello <%= name %>! 👋
                        </h2>

                        <p style="
                            margin: 0 0 25px;
                            font-size: 15px;
                            line-height: 1.7;
                            color: #6b7280;
                        ">
                            You requested a new verification code.
                            Use the code below to verify your email address
                            and complete your registration.
                        </p>

                        <!-- OTP -->
                        <div style="
                            background-color: #f5f3ff;
                            border: 1px solid #ddd6fe;
                            border-radius: 12px;
                            padding: 25px 20px;
                            text-align: center;
                            margin-bottom: 25px;
                        ">

                            <p style="
                                margin: 0 0 10px;
                                color: #6b7280;
                                font-size: 13px;
                                text-transform: uppercase;
                                letter-spacing: 1.5px;
                                font-weight: 600;
                            ">
                                New Verification Code  
                            </p>

                            <h2 style="
                                font-size: 36px;
                                font-weight: 700;
                                letter-spacing: 8px;
                                color: #7c3aed;
                            ">

                            <%= otp %>
                               
                        </h2>

                        </div>

                        <!-- Expiration -->
                        <div style="
                            background-color: #fffbeb;
                            border-left: 4px solid #f59e0b;
                            padding: 13px 16px;
                            margin-bottom: 25px;
                        ">

                            <p style="
                                margin: 0;
                                font-size: 13px;
                                color: #92400e;
                            ">
                                ⏱️ This new code will expire in
                                <strong><%= expirationMinutes %> minutes</strong>.
                            </p>

                        </div>

                        <!-- Important Notice -->
                        <div style="
                            background-color: #fef2f2;
                            border: 1px solid #fecaca;
                            border-radius: 10px;
                            padding: 15px;
                            margin-bottom: 20px;
                        ">

                            <p style="
                                margin: 0;
                                font-size: 13px;
                                line-height: 1.5;
                                color: #991b1b;
                            ">
                                🔐 <strong>Important:</strong> Your previous
                                verification code is no longer valid.
                                Please use this new code instead.
                            </p>

                        </div>

                        <p style="
                            margin: 0;
                            font-size: 14px;
                            line-height: 1.6;
                            color: #6b7280;
                        ">
                            If you didn't request a new verification code,
                            you can safely ignore this email.
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="
                        background-color: #f9fafb;
                        border-top: 1px solid #e5e7eb;
                        padding: 22px 30px;
                        text-align: center;
                    ">

                        <p style="
                            margin: 0 0 8px;
                            font-size: 13px;
                            color: #9ca3af;
                        ">
                            🔒 Never share your verification code with anyone.
                        </p>

                        <p style="
                            margin: 0;
                            font-size: 12px;
                            color: #d1d5db;
                        ">
                            © 2026 Your App. All rights reserved.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>