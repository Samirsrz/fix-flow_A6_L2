<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your FixFlow Account</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 40px 15px;">
    <tr>
        <td align="center">

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                max-width: 520px;
                background-color: #ffffff;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 6px 25px rgba(0,0,0,0.07);
            ">

                <!-- Header -->
                <tr>
                    <td style="
                        background: linear-gradient(135deg, #2563eb, #4f46e5);
                        padding: 30px;
                        text-align: center;
                    ">

                        <h1 style="
                            margin: 0;
                            color: #ffffff;
                            font-size: 27px;
                        ">
                            Welcome to FixFlow
                        </h1>

                        <p style="
                            margin: 8px 0 0;
                            color: #dbeafe;
                            font-size: 14px;
                        ">
                            Your account has been created
                        </p>

                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding: 35px;">

                        <h2 style="
                            margin: 0 0 15px;
                            color: #111827;
                            font-size: 21px;
                        ">
                            Hello <%= name %> 👋
                        </h2>

                        <p style="
                            margin: 0 0 25px;
                            color: #6b7280;
                            font-size: 15px;
                            line-height: 1.7;
                        ">
                            An administrator has created a FixFlow account
                            for you. You can use the credentials below to
                            sign in to your account.
                        </p>

                        <!-- Credentials -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                            background-color: #f8fafc;
                            border: 1px solid #e2e8f0;
                            border-radius: 10px;
                            margin-bottom: 25px;
                        ">

                            <tr>
                                <td style="
                                    padding: 15px 18px;
                                    border-bottom: 1px solid #e2e8f0;
                                ">
                                    <p style="
                                        margin: 0 0 5px;
                                        color: #64748b;
                                        font-size: 12px;
                                        text-transform: uppercase;
                                        letter-spacing: 1px;
                                    ">
                                        Email
                                    </p>

                                    <p style="
                                        margin: 0;
                                        color: #111827;
                                        font-size: 15px;
                                        font-weight: 600;
                                    ">
                                        <%= email %>
                                    </p>
                                </td>
                            </tr>

                            <tr>
                                <td style="
                                    padding: 15px 18px;
                                    border-bottom: 1px solid #e2e8f0;
                                ">
                                    <p style="
                                        margin: 0 0 5px;
                                        color: #64748b;
                                        font-size: 12px;
                                        text-transform: uppercase;
                                        letter-spacing: 1px;
                                    ">
                                        Temporary Password
                                    </p>

                                    <p style="
                                        margin: 0;
                                        color: #111827;
                                        font-size: 15px;
                                        font-weight: 600;
                                        font-family: monospace;
                                    ">
                                        <%= password %>
                                    </p>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding: 15px 18px;">
                                    <p style="
                                        margin: 0 0 5px;
                                        color: #64748b;
                                        font-size: 12px;
                                        text-transform: uppercase;
                                        letter-spacing: 1px;
                                    ">
                                        Role
                                    </p>

                                    <p style="
                                        margin: 0;
                                        color: #2563eb;
                                        font-size: 15px;
                                        font-weight: 600;
                                    ">
                                        <%= role %>
                                    </p>
                                </td>
                            </tr>

                        </table>

                        <!-- Security Notice -->
                        <div style="
                            background-color: #fff7ed;
                            border-left: 4px solid #f97316;
                            padding: 14px 16px;
                            border-radius: 4px;
                            margin-bottom: 25px;
                        ">

                            <p style="
                                margin: 0 0 5px;
                                color: #9a3412;
                                font-size: 14px;
                                font-weight: 700;
                            ">
                                🔒 Important
                            </p>

                            <p style="
                                margin: 0;
                                color: #9a3412;
                                font-size: 13px;
                                line-height: 1.5;
                            ">
                                Please change your temporary password after
                                signing in and do not share your credentials
                                with anyone.
                            </p>

                        </div>

                        <p style="
                            margin: 0;
                            text-align: center;
                            color: #9ca3af;
                            font-size: 13px;
                            line-height: 1.6;
                        ">
                            Welcome to FixFlow. We're glad to have you with us!
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="
                        background-color: #f9fafb;
                        border-top: 1px solid #e5e7eb;
                        padding: 20px 30px;
                        text-align: center;
                    ">

                        <p style="
                            margin: 0 0 6px;
                            color: #9ca3af;
                            font-size: 12px;
                        ">
                            This is an automated email from FixFlow.
                        </p>

                        <p style="
                            margin: 0;
                            color: #d1d5db;
                            font-size: 11px;
                        ">
                            © 2026 FixFlow. All rights reserved.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>