<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Changed Successfully</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 40px 15px;">
    <tr>
        <td align="center">

            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                max-width: 520px;
                background-color: #ffffff;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            ">

                <!-- Header -->
                <tr>
                    <td style="
                        background: linear-gradient(135deg, #10b981, #059669);
                        padding: 38px 30px;
                        text-align: center;
                    ">

                        <div style="
                            width: 70px;
                            height: 70px;
                            margin: 0 auto 16px;
                            background-color: rgba(255,255,255,0.18);
                            border-radius: 50%;
                            line-height: 70px;
                            font-size: 34px;
                            color: #ffffff;
                        ">
                            ✓
                        </div>

                        <h1 style="
                            margin: 0;
                            color: #ffffff;
                            font-size: 27px;
                            font-weight: 700;
                        ">
                            Password Changed
                        </h1>

                        <p style="
                            margin: 10px 0 0;
                            color: #d1fae5;
                            font-size: 14px;
                        ">
                            Your account is secure
                        </p>

                    </td>
                </tr>

                <!-- Content -->
                <tr>
                    <td style="padding: 40px 35px;">

                        <h2 style="
                            margin: 0 0 15px;
                            font-size: 22px;
                            color: #111827;
                        ">
                            Hello <%= name %> 👋
                        </h2>

                        <p style="
                            margin: 0 0 25px;
                            font-size: 15px;
                            line-height: 1.7;
                            color: #6b7280;
                        ">
                            Your FixFlow account password has been
                            successfully changed.
                        </p>

                        <!-- Success Box -->
                        <div style="
                            background-color: #ecfdf5;
                            border: 1px solid #a7f3d0;
                            border-radius: 12px;
                            padding: 20px;
                            margin-bottom: 25px;
                        ">

                            <p style="
                                margin: 0 0 8px;
                                color: #047857;
                                font-size: 15px;
                                font-weight: 700;
                            ">
                                ✓ Password successfully updated
                            </p>

                            <p style="
                                margin: 0;
                                color: #065f46;
                                font-size: 14px;
                                line-height: 1.6;
                            ">
                                Your new password is now active.
                                You can use it the next time you sign in
                                to your FixFlow account.
                            </p>

                        </div>

                        <!-- Security Alert -->
                        <div style="
                            background-color: #fff7ed;
                            border-left: 4px solid #f97316;
                            padding: 14px 16px;
                            margin-bottom: 25px;
                            border-radius: 4px;
                        ">

                            <p style="
                                margin: 0 0 6px;
                                color: #9a3412;
                                font-size: 14px;
                                font-weight: 700;
                            ">
                                🔒 Wasn't you?
                            </p>

                            <p style="
                                margin: 0;
                                color: #9a3412;
                                font-size: 13px;
                                line-height: 1.5;
                            ">
                                If you didn't make this change, please
                                secure your account immediately and
                                contact FixFlow support.
                            </p>

                        </div>

                        <p style="
                            margin: 0;
                            font-size: 14px;
                            line-height: 1.6;
                            color: #9ca3af;
                            text-align: center;
                        ">
                            Thank you for keeping your FixFlow account secure.
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="
                        background-color: #f9fafb;
                        border-top: 1px solid #e5e7eb;
                        padding: 22px 30px;
                        text-align: center;
                    ">

                        <p style="
                            margin: 0 0 8px;
                            font-size: 13px;
                            color: #9ca3af;
                        ">
                            This is an automated security notification from FixFlow.
                        </p>

                        <p style="
                            margin: 0;
                            font-size: 12px;
                            color: #d1d5db;
                        ">
                            © 2026 FixFlow. All rights reserved.
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>