model Issue {
  id               String      @id @default(uuid())
  residentId       String
  resident         Resident    @relation("ReportedIssues", fields: [residentId], references: [id])
  communityId      String
  community        Community   @relation(fields: [communityId], references: [id])
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  title            String
  description      String
  location         String?
  images           String[]    @default([])
  priority         Priority?
  status           IssueStatus @default(REPORTED)
  assignedWorkerId String?
  assignedWorker   Worker?     @relation("AssignedWorker", fields: [assignedWorkerId], references: [id])
  slaDeadline      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workerUpdates WorkerUpdate[]
  messages      Message[]
  feedback      Feedback?

  @@index([status])
  @@index([communityId])
  @@index([priority])
  @@index([assignedWorkerId])
  @@map("issues")
}